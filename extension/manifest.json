{
  "manifest_version": 3,
  "name": "Tweet Cleaner",
  "version": "3.1.1",
  "description": "Limpe posts, reposts, bookmarks e likes do X com prévia, pausa e retomada. Gratuito, com progresso salvo localmente.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Abrir Tweet Cleaner",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
